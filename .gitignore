# Secrets et fichiers locaux : ne jamais les versionner
.env
.env.*
*.pem
*.key
.dev.vars
.wrangler/
service-account*.json
firebase-adminsdk*.json
node_modules/
.DS_Store

# Rapports d'audit des clients (confidentiels)
audits/
assets/social/_tmp.html

# Contrats et documents nominatifs : jamais dans le dépôt
contrats/

# Sites clients en préparation (outil tools/nouveau-client.js) : jamais versionnés
clients/

# Fiches de paie réelles lues pour l entraînement (montants de personnes : jamais versionnés)
tools/fixtures/fiches-reelles*.json
