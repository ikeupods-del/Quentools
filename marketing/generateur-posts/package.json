{
  "name": "studio-posts",
  "productName": "Studio Posts",
  "version": "1.2.0",
  "description": "Publications Instagram et TikTok aux couleurs du Parvis et de QuenTools",
  "main": "main.js",
  "private": true,
  "author": "QuenTools",
  "scripts": {
    "start": "electron .",
    "donnees": "node ../../tools/generateur-posts.js",
    "dist": "node ../../tools/synchro-ia-locale.js && node ../../tools/generateur-posts.js && electron-builder --mac dmg --arm64 --publish never"
  },
  "build": {
    "appId": "fr.quentools.studioposts",
    "productName": "Studio Posts",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "donnees.js",
      "generation.js",
      "ia-locale.js",
      "ia-worker.js",
      "package.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "Studio-Posts-${version}-arm64.${ext}"
    },
    "dmg": {
      "title": "Studio Posts"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1"
  }
}
