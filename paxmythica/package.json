{
  "name": "pax-mythica",
  "productName": "Pax Mythica",
  "version": "1.6.0",
  "description": "Jeu de stratégie mythologique : panthéons, dieux, créatures et décrets libres",
  "main": "main.js",
  "private": true,
  "author": "QuenTools",
  "scripts": {
    "start": "electron .",
    "test": "node tests/moteur.js && node tests/interface.js",
    "dist": "node ../tools/synchro-ia-locale.js && electron-builder --mac dmg --arm64 --publish never"
  },
  "build": {
    "appId": "fr.quentools.paxmythica",
    "productName": "Pax Mythica",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "donnees.js",
      "epoques.js",
      "carte.js",
      "moteur.js",
      "alliances.js",
      "ia-nations.js",
      "oracle.js",
      "rendu.js",
      "vue3d.js",
      "rts-donnees.js",
      "rts-moteur.js",
      "rts-vue.js",
      "rts-interface.js",
      "packs-graphiques.js",
      "vendor/LICENCES.txt",
      "son.js",
      "interface.js",
      "ia-locale.js",
      "ia-worker.js",
      "maj.js",
      "package.json",
      "vendor/three-pax.min.js",
      "ressources3d.js",
      "ressources/LICENCES.json",
      "ressources/materiaux/**/*.jpg",
      "ressources/ciels/*.hdr",
      "ressources/feuillages/*.png",
      "ressources/jeu/*.glb",
      "ressources/personnages/*",
      "ressources/modeles/sapin/textures/fir_tree_01_bark_diff_1k.jpg",
      "ressources/modeles/sapin/textures/fir_tree_01_bark_nor_gl_1k.jpg"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.strategy-games",
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "Pax-Mythica-${version}-arm64.${ext}"
    },
    "dmg": {
      "title": "Pax Mythica"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1"
  }
}
