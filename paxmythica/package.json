{
  "name": "pax-mythica",
  "productName": "Pax Mythica",
  "version": "1.0.1",
  "description": "Jeu de stratégie mythologique : panthéons, dieux, créatures et décrets libres",
  "main": "main.js",
  "private": true,
  "author": "QuenTools",
  "scripts": {
    "start": "electron .",
    "test": "node tests/moteur.js && node tests/interface.js",
    "dist": "node ../tools/synchro-ia-locale.js && electron-builder --mac dmg --arm64 --publish never"
  },
  "build": {
    "appId": "fr.quentools.paxmythica",
    "productName": "Pax Mythica",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "donnees.js",
      "epoques.js",
      "carte.js",
      "moteur.js",
      "alliances.js",
      "ia-nations.js",
      "oracle.js",
      "rendu.js",
      "vue3d.js",
      "vendor/three.min.js",
      "vendor/effets/CopyShader.js",
      "vendor/effets/SimplexNoise.js",
      "vendor/effets/SSAOShader.js",
      "vendor/effets/LuminosityHighPassShader.js",
      "vendor/effets/FXAAShader.js",
      "vendor/effets/HorizontalTiltShiftShader.js",
      "vendor/effets/VerticalTiltShiftShader.js",
      "vendor/effets/EffectComposer.js",
      "vendor/effets/MaskPass.js",
      "vendor/effets/RenderPass.js",
      "vendor/effets/ShaderPass.js",
      "vendor/effets/SSAOPass.js",
      "vendor/effets/UnrealBloomPass.js",
      "packs-graphiques.js",
      "vendor/LICENCES.txt",
      "son.js",
      "interface.js",
      "ia-locale.js",
      "ia-worker.js",
      "maj.js",
      "package.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.strategy-games",
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "Pax-Mythica-${version}-arm64.${ext}"
    },
    "dmg": {
      "title": "Pax Mythica"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1"
  }
}
