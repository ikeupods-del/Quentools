{
  "name": "quentmovie",
  "version": "2.7.3",
  "description": "QuentMovie : logiciel de montage vidéo pour Mac",
  "author": "QuenTools",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serveur": "node server.js",
    "test": "node tests/tous.js",
    "dist": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "ffmpeg-static": "^5.2.0",
    "node-llama-cpp": "3.21.1",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "^25.1.8",
    "ffprobe-static": "^3.1.0",
    "playwright-core": "^1.55.0"
  },
  "build": {
    "appId": "fr.quentools.quentmovie",
    "productName": "QuentMovie",
    "files": [
      "main.js",
      "server.js",
      "effects.js",
      "packs.js",
      "ffmpeg-path.js",
      "maj.js",
      "memoire.js",
      "generateur.js",
      "compositeur.js",
      "detoureur.js",
      "parole.js",
      "voix-texte.js",
    "prononciations.json",
      "images.js",
      "script-qualite.js",
      "rythme.js",
      "banques.js",
      "assistant.js",
      "epissage.js",
      "chapitrage.js",
      "decoupe.js",
      "parole-worker.js",
    "voix-clone.js",
    "routes-voix.js",
    "publication.js",
    "routes-publier.js",
    "ui-voix.js",
    "ui-publier.js",
    "ui-v2.js",
    "ui-chat.js",
    "ui-retours.js",
    "ui-projets.js",
    "routes-projets.js",
    "routes-pico.js",
    "routes-animations.js",
    "animations.js",
    "ui-animations.js",
    "navigateur-pont.js",
    "navigateur-electron.js",
    "fiche-quentinvest.js",
    "fiche-ia.js",
    "prononciation-controle.js",
    "voix-clone/**",
      "ia.js",
      "ia-worker.js",
      "modeles/**",
      "!node_modules/@mediapipe/tasks-vision/*.map",
      "!node_modules/@mediapipe/tasks-vision/vision_bundle.cjs",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_module_internal.*",
      "index.html",
      "package.json",
      "bibliotheque/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "bibliotheque/**",
      "voix-clone/**"
    ],
    "extraResources": [
      { "from": "../design/quentinvest-youtube/fabrication", "to": "pico/fabrication", "filter": ["*.js", "*.json"] },
      { "from": "../design/quentinvest-youtube/personnage", "to": "pico/personnage", "filter": ["png/**", "svg/**"] },
      { "from": "../assets/fonts/inter.woff2", "to": "pico/assets/fonts/inter.woff2" }
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "QuentMovie utilise le micro pour enregistrer ta voix (voix off, studio).",
        "NSScreenCaptureUsageDescription": "QuentMovie partage et enregistre ton écran dans le studio (« Afficher en direct »).",
        "NSCameraUsageDescription": "QuentMovie utilise la caméra pour te filmer dans le studio (prompteur)."
      }
    },
    "dmg": {
      "title": "QuentMovie"
    },
    "directories": {
      "output": "dist"
    }
  }
}
