{
  "name": "quentmovie",
  "version": "1.7.0",
  "description": "QuentMovie : logiciel de montage vidéo pour Mac",
  "author": "QuenTools",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serveur": "node server.js",
    "test": "node tests/run.js && node tests/maj.js && node tests/compositeur.js && node tests/generateur.js && node tests/parole.js && node tests/pistes.js",
    "dist": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "ffmpeg-static": "^5.2.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "fr.quentools.quentmovie",
    "productName": "QuentMovie",
    "files": [
      "main.js",
      "server.js",
      "effects.js",
      "ffmpeg-path.js",
      "maj.js",
      "generateur.js",
      "compositeur.js",
      "detoureur.js",
      "parole.js",
      "parole-worker.js",
      "modeles/**",
      "!node_modules/@mediapipe/tasks-vision/*.map",
      "!node_modules/@mediapipe/tasks-vision/vision_bundle.cjs",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_module_internal.*",
      "index.html",
      "package.json",
      "bibliotheque/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sherpa-onnx-*/**",
      "bibliotheque/**"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "QuentMovie utilise le micro pour enregistrer ta voix (voix off, studio).",
        "NSCameraUsageDescription": "QuentMovie utilise la caméra pour te filmer dans le studio (prompteur)."
      }
    },
    "dmg": {
      "title": "QuentMovie"
    },
    "directories": {
      "output": "dist"
    }
  }
}
