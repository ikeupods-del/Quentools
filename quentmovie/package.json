{
  "name": "quentmovie",
  "version": "1.0.0",
  "description": "QuentMovie : logiciel de montage vidéo pour Mac",
  "author": "QuenTools",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serveur": "node server.js",
    "test": "node tests/run.js",
    "dist": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.quentools.quentmovie",
    "productName": "QuentMovie",
    "files": ["main.js", "server.js", "effects.js", "ffmpeg-path.js", "index.html", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": { "category": "public.app-category.video", "identity": null, "icon": "build/icon.png" },
    "dmg": { "title": "QuentMovie" },
    "directories": { "output": "dist" }
  }
}
